
    programa {
  funcao inicio() {
    real salario 
    real salariofinal
    real salariototal
    logico beneficio = verdadeiro

    escreva ("Salario: ")
    leia (salario)

    escreva (" se enquadra ao beneficio: ")
    leia (beneficio == verdadeiro)

    salariototal = salario * 0.15
    salariofinal = salario + salariototal

    se (salario<= 2000)
    escreva ("Salario final: ", salariofinal)
    senao 
    escreva("Salario final sem aumento:  ",salario)
    

    
  }
}
